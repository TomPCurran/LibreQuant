# LibreQuant local environment template — copy to `.env.local` (see librequant/README.md, Configuration).
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the client bundle at BUILD time (`next build`).
# Set them before `npm run build`, not only before `npm run start`. `prebuild` creates `.env.local`
# from this file when missing so a typical local build picks up defaults.
#
# --- Stack scripts (dev-stack.mjs / stack-common.mjs) ---
# Those Node scripts read the same Jupyter keys from the shell environment (not from this Zod layer).
# Ensure Compose / shell exports align with the values below when using `npm run dev:stack`.

# =============================================================================
# Jupyter (NEXT_PUBLIC_* — embedded in the browser bundle)
# =============================================================================
# Optional: HTTP origin for Jupyter Server (no trailing slash). Default http://127.0.0.1:8888
# Use 127.0.0.1 so the browser hits IPv4 loopback: Docker maps 127.0.0.1:8888 only; "localhost"
# often resolves to ::1 on macOS and fails with ECONNREFUSED. (App normalizes localhost→127.0.0.1.)
NEXT_PUBLIC_JUPYTER_BASE_URL=http://127.0.0.1:8888

# Optional: login token for Jupyter (must match Docker `--IdentityProvider.token`). Default devtoken when unset and URL is default 127.0.0.1:8888, or in development — see lib/env.ts (Zod).
# Sensitive: equivalent to Jupyter login; do not commit real secrets to public repos
NEXT_PUBLIC_JUPYTER_TOKEN=devtoken

# Optional: directory (Jupyter contents path) for the notebook library — relative to server root, no leading slash. Invalid values fail startup (no silent fallback).
NEXT_PUBLIC_JUPYTER_NOTEBOOK_ROOT=work/librequant

# Optional: absolute path to Jupyter Linux user home inside the container (safe POSIX path only). Default /home/jovyan.
# NEXT_PUBLIC_JUPYTER_USER_HOME=/home/jovyan

# Optional: set to 0 only to force browser-side sys.path injection (e.g. external Jupyter without PYTHONPATH). Any other value = assume Docker PYTHONPATH.
# If you change NOTEBOOK_ROOT or USER_HOME, update PYTHONPATH in docker-compose.yml to match lib/env.ts.
NEXT_PUBLIC_STRATEGIES_VIA_PYTHONPATH=1

# Optional: set to 1 to show full Jupyter/Yjs console output in dev (default filters known benign noise)
# NEXT_PUBLIC_JUPYTER_VERBOSE=1

# =============================================================================
# MLflow — browser (NEXT_PUBLIC_*)
# =============================================================================
# Optional: MLflow Tracking UI origin for sidebar iframe, “Open MLflow UI”, and CSP frame-src. Default http://127.0.0.1:5000
# NEXT_PUBLIC_MLFLOW_UI_URL=http://127.0.0.1:5000

# Optional: interval in ms for polling `/api/mlflow/experiments` (default 12000; integer >= 1000 required when set)
# NEXT_PUBLIC_MLFLOW_EXPERIMENTS_POLL_MS=12000

# =============================================================================
# MLflow — Next.js server only (not NEXT_PUBLIC_*; read in Route Handlers, see lib/server-env.ts)
# =============================================================================
# Optional: MLflow Tracking REST API base URL (no trailing slash). Default http://127.0.0.1:5000
# Resolution order (same as previous lib/mlflow-server.ts): MLFLOW_TRACKING_URI if set, else MLFLOW_API_BASE_URL if set, else default.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
#
# Optional: alternate name for the same server URL (used only when MLFLOW_TRACKING_URI is unset)
# MLFLOW_API_BASE_URL=http://127.0.0.1:5000

# Optional: when set to 1, `/api/mlflow/*` returns 403 if X-Forwarded-For / X-Real-IP implies a non-loopback client (best-effort; see SECURITY.md). Evaluated at request time.
# MLFLOW_PROXY_REQUIRE_LOOPBACK=1

# =============================================================================
# Misc (NEXT_PUBLIC_*)
# =============================================================================
# Optional: prefix for browser console messages (default LibreQuant). Set to empty string to omit the bracketed prefix.
# NEXT_PUBLIC_CLIENT_LOG_PREFIX=MyProject

# =============================================================================
# Docker Compose (repo root `.env` for interpolation — not all read by Next Zod)
# =============================================================================
# Must match NEXT_PUBLIC_JUPYTER_TOKEN when using compose defaults
JUPYTER_TOKEN=devtoken
#
# Where Jupyter stores notebooks on your machine: set LIBREQUANT_JUPYTER_WORKSPACE_HOST in a repo-root `.env`
# (see ../env.docker.example). Not read from this file — Compose interpolation uses the repo root `.env` only.

# --- Server-only / Jupyter: market data API keys (never NEXT_PUBLIC_*) ---
# Copy real values into `.env.local` only; never commit `.env.local`.
# Docker Compose loads this file into the Jupyter container (see repo root docker-compose.yml)
# so notebook kernels can use the same keys as the Next.js server.
# Optional Alpaca Market Data (https://alpaca.markets/)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# Optional: Alpaca data feed (default iex; use sip if your subscription includes it)
# ALPACA_DATA_FEED=iex
# Optional Polygon / Tiingo (connectors planned; keys reserved for future use)
# POLYGON_API_KEY=
# TIINGO_API_KEY=

# Custom API keys (uppercase A–Z / 0–9 / underscore; set via Data sources UI or add manually)
# MY_VENDOR_API_KEY=
